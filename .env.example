# Copy to .env. Never commit credentials.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Models for paper extraction, strategy workers and narrative critics:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Each role: anthropic:<model-id> or openai:<model-id>. No default model.
EXTRACTOR_MODEL=
WORKER_MODEL=
CRITIC_MODEL=
# Optional USD per million tokens; missing rates produce unknown cost.
# Set INPUT, OUTPUT, CACHE_READ, CACHE_WRITE and CACHE_WRITE_LONG for each role.
# CACHE_WRITE is the default TTL; CACHE_WRITE_LONG is 12h OpenAI / 1h Anthropic.
EXTRACTOR_INPUT_USD_PER_MTOK=
EXTRACTOR_OUTPUT_USD_PER_MTOK=
EXTRACTOR_CACHE_READ_USD_PER_MTOK=
EXTRACTOR_CACHE_WRITE_USD_PER_MTOK=
EXTRACTOR_CACHE_WRITE_LONG_USD_PER_MTOK=
WORKER_INPUT_USD_PER_MTOK=
WORKER_OUTPUT_USD_PER_MTOK=
WORKER_CACHE_READ_USD_PER_MTOK=
WORKER_CACHE_WRITE_USD_PER_MTOK=
WORKER_CACHE_WRITE_LONG_USD_PER_MTOK=
CRITIC_INPUT_USD_PER_MTOK=
CRITIC_OUTPUT_USD_PER_MTOK=
CRITIC_CACHE_READ_USD_PER_MTOK=
CRITIC_CACHE_WRITE_USD_PER_MTOK=
CRITIC_CACHE_WRITE_LONG_USD_PER_MTOK=
